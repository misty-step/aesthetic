{
  "version": "alpha",
  "name": "Misty Step",
  "description": "One identity for the Misty Step studio and mistystack, its open method for coding agents. Locked 2026-11-06 (MIS-866).",
  "colors": {
    "primary": "#5B5BF0",
    "secondary": "#8B5CF6",
    "ink": "#0E0F13",
    "graphite": "#646A77",
    "steel": "#A7ABB8",
    "canvas": "#F7F6F3",
    "surface": "#FFFFFF",
    "border": "#E4E3DF",
    "on-primary": "#FFFFFF",
    "dark-canvas": "#0B0C10",
    "dark-surface": "#15171D",
    "dark-border": "#262833",
    "dark-text": "#F7F6F3",
    "dark-primary": "#7C7CF5"
  },
  "typography": {
    "display": {
      "fontFamily": "Hedvig Letters Serif",
      "fontSize": "96px",
      "fontWeight": 400,
      "lineHeight": 0.92,
      "letterSpacing": "-0.02em"
    },
    "heading": {
      "fontFamily": "Hedvig Letters Serif",
      "fontSize": "48px",
      "fontWeight": 400,
      "lineHeight": 0.94,
      "letterSpacing": "-0.02em"
    },
    "title": {
      "fontFamily": "Hedvig Letters Serif",
      "fontSize": "24px",
      "fontWeight": 400,
      "lineHeight": 1.2,
      "letterSpacing": "-0.02em"
    },
    "body": {
      "fontFamily": "Uncut Sans",
      "fontSize": "18px",
      "fontWeight": 400,
      "lineHeight": 1.5
    },
    "label": {
      "fontFamily": "Uncut Sans",
      "fontSize": "14px",
      "fontWeight": 500,
      "lineHeight": 1.4
    },
    "mono": {
      "fontFamily": "Commit Mono",
      "fontSize": "14px",
      "fontWeight": 400,
      "lineHeight": 1.4
    }
  },
  "rounded": {
    "sm": "6px",
    "md": "8px",
    "lg": "12px",
    "full": "9999px"
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "48px",
    "section": "96px"
  },
  "components": {
    "button-primary": {
      "backgroundColor": "{colors.primary}",
      "textColor": "{colors.on-primary}",
      "typography": "{typography.label}",
      "rounded": "{rounded.md}",
      "padding": "12px"
    },
    "button-secondary": {
      "backgroundColor": "{colors.surface}",
      "textColor": "{colors.ink}",
      "typography": "{typography.label}",
      "rounded": "{rounded.md}",
      "padding": "12px"
    },
    "input": {
      "backgroundColor": "{colors.surface}",
      "textColor": "{colors.ink}",
      "typography": "{typography.body}",
      "rounded": "{rounded.md}",
      "padding": "12px"
    },
    "tag": {
      "backgroundColor": "{colors.canvas}",
      "textColor": "{colors.graphite}",
      "typography": "{typography.label}",
      "rounded": "{rounded.full}",
      "padding": "8px"
    },
    "card": {
      "backgroundColor": "{colors.surface}",
      "textColor": "{colors.ink}",
      "rounded": "{rounded.lg}",
      "padding": "24px"
    },
    "code": {
      "backgroundColor": "{colors.ink}",
      "textColor": "{colors.canvas}",
      "typography": "{typography.mono}",
      "rounded": "{rounded.md}",
      "padding": "16px"
    },
    "page-dark": {
      "backgroundColor": "{colors.dark-canvas}",
      "textColor": "{colors.dark-text}"
    },
    "card-dark": {
      "backgroundColor": "{colors.dark-surface}",
      "textColor": "{colors.dark-text}",
      "rounded": "{rounded.lg}",
      "padding": "24px"
    },
    "link-dark": {
      "backgroundColor": "{colors.dark-canvas}",
      "textColor": "{colors.dark-primary}"
    },
    "divider": { "backgroundColor": "{colors.border}" },
    "divider-dark": { "backgroundColor": "{colors.dark-border}" },
    "caption-dark": {
      "backgroundColor": "{colors.dark-surface}",
      "textColor": "{colors.steel}",
      "typography": "{typography.mono}"
    }
  }
}
